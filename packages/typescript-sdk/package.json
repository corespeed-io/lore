{
  "name": "@corespeed/lore-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Lore portable memory API.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun --no-env-file -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && bun --no-env-file --bun tsc -p tsconfig.json",
    "prepack": "bun --no-env-file run --cwd ../.. sdk:check && bun --no-env-file run build"
  },
  "publishConfig": {
    "access": "public"
  }
}
