{
  "name": "@corespeed/lore-core",
  "version": "0.1.0",
  "description": "Lore's reusable memory engine: multi-tenant Memory storage, chunking, hybrid retrieval, links, and leased embedding maintenance over PostgreSQL RLS.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./postgres": "./src/postgres.ts",
    "./episodes": "./src/episodes/index.ts",
    "./providers": "./src/providers.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-pgvector": "^0.0.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
