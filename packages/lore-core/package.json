{
  "name": "@corespeed/lore-core",
  "private": true,
  "version": "0.1.0",
  "description": "Lore's reusable memory engine: Memory storage, chunking, retrieval algorithms, links, and leased embedding maintenance over host-constrained PostgreSQL transactions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./postgres": "./src/postgres.ts",
    "./episodes": "./src/episodes/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun --no-env-file --bun vitest run",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
