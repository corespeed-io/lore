{
  "name": "lore",
  "version": "0.1.0",
  "description": "Open-source memory infrastructure for users and their agents.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "tools/sdk-codegen"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "homepage": "https://github.com/corespeed-io/lore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corespeed-io/lore.git"
  },
  "bugs": {
    "url": "https://github.com/corespeed-io/lore/issues"
  },
  "keywords": [
    "memory",
    "agents",
    "multi-tenant",
    "postgres",
    "rls"
  ],
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build && bun run build:maintenance && bun run build:dbmate && bun run build:packages",
    "build:maintenance": "bun build src/worker/maintenance.ts --target=bun --outdir=.worker --entry-naming=maintenance-worker.js --external pg",
    "build:dbmate": "bun --no-env-file scripts/build/build-dbmate.ts",
    "build:packages": "bun run sdk:check && bun run --cwd packages/typescript-sdk build && bun run --cwd packages/cli build && bun run --cwd packages/mcp build",
    "packages:smoke": "bun run sdk:check && bun --no-env-file scripts/build/package-smoke.ts",
    "smoke:memory-core": "bun scripts/checks/smoke-memory-core.ts",
    "smoke:next": "bun scripts/checks/smoke-next.ts",
    "db:migrate": "bun --no-env-file scripts/database/migrate.ts",
    "db:preflight": "bun --no-env-file scripts/database/run-preflight.ts",
    "db:bootstrap": "bun --no-env-file scripts/database/migrate.ts && bun --no-env-file scripts/database/create-runtime-role.ts",
    "db:backup": "bun --no-env-file scripts/database/backup.ts",
    "db:restore": "bun --no-env-file scripts/database/restore.ts",
    "db:pitr:check": "bun --no-env-file scripts/database/run-pitr-check.ts",
    "db:embedding:report": "bun scripts/database/embedding-generation.ts report",
    "db:embedding:activate": "bun scripts/database/embedding-generation.ts activate",
    "benchmark:graph:seed": "bun --no-env-file tools/evaluation/graph/seed-graph-benchmark.ts",
    "benchmark:code-index": "bun tools/evaluation/code/run-code-index.ts",
    "benchmark:code-search": "bun tools/evaluation/code/run-code-search.ts",
    "benchmark:memory-chunking": "bun tools/evaluation/chunking/run-memory-chunking.ts",
    "benchmark:retrieval-policy": "bun tools/evaluation/policy/run-retrieval-policy.ts",
    "evaluate:code-aware-memory": "bun tools/evaluation/code/evaluate-code-aware-memory.ts",
    "evaluate:code-aware-memory:stress": "bun tools/evaluation/code/evaluate-code-aware-memory.ts --suite dependency-stress",
    "evaluate:joint-memory-code": "bun tools/evaluation/context/evaluate-joint-memory-code.ts",
    "evaluate:joint-memory-code:real": "bun tools/evaluation/context/evaluate-joint-memory-code-real.ts",
    "benchmark:retrieval": "bun tools/evaluation/retrieval/run-retrieval.ts",
    "benchmark:longmemeval:fetch": "bun tools/evaluation/retrieval/fetch-longmemeval.ts",
    "benchmark:longmemeval": "bun tools/evaluation/retrieval/run-longmemeval.ts",
    "benchmark:longmemeval:smoke": "bun tools/evaluation/retrieval/run-longmemeval.ts --split oracle --max-cases 10",
    "benchmark:longmemeval-v2:fetch": "bun tools/evaluation/retrieval/fetch-longmemeval-v2.ts",
    "benchmark:longmemeval-v2": "bun tools/evaluation/retrieval/run-longmemeval-v2.ts",
    "benchmark:locomo:fetch": "bun tools/evaluation/retrieval/fetch-locomo.ts",
    "benchmark:locomo": "bun tools/evaluation/retrieval/run-locomo.ts",
    "benchmark:locomo:retrieval": "bun tools/evaluation/retrieval/run-locomo-retrieval.ts",
    "benchmark:memoryagentbench:fetch": "bun tools/evaluation/retrieval/fetch-memoryagentbench.ts",
    "benchmark:memoryagentbench": "bun tools/evaluation/retrieval/run-memoryagentbench.ts",
    "benchmark:memoryagentbench:accurate": "bun tools/evaluation/retrieval/run-memoryagentbench-accurate.ts",
    "prototype:graph-scale": "BENCHMARK_DATABASE_URL=postgres://localhost:5432/lore_graph_benchmark bun --bun next dev",
    "service:up": "bun --no-env-file scripts/dev/local-service.ts up",
    "service:down": "bun --no-env-file scripts/dev/local-service.ts down",
    "service:restart": "bun --no-env-file scripts/dev/local-service.ts restart",
    "service:status": "bun --no-env-file scripts/dev/local-service.ts status",
    "service:logs": "bun --no-env-file scripts/dev/local-service.ts logs",
    "service:test": "bun --no-env-file test ./scripts/dev/local-service.test.ts",
    "start": "bun --bun next start",
    "start:maintenance": "bun --no-env-file .worker/maintenance-worker.js",
    "preview:cloudflare": "bun --bun opennextjs-cloudflare build && bun --bun opennextjs-cloudflare preview",
    "deploy:cloudflare": "bun --bun opennextjs-cloudflare build && bun --bun opennextjs-cloudflare deploy",
    "cf:typegen": "bun --bun wrangler types --env-interface CloudflareEnv --env-file .dev.vars.example --strict-vars false cloudflare-env.d.ts",
    "design:check": "bun --no-env-file scripts/checks/check-design-system.ts . && bun --no-env-file test ./scripts/checks/check-design-system.test.ts",
    "lint": "biome check .",
    "sdk:check": "bun tools/sdk-codegen/generate.ts --check",
    "sdk:generate": "bun tools/sdk-codegen/generate.ts",
    "format": "biome check --write .",
    "test": "bun --no-env-file --bun vitest run && bun run --cwd packages/lore-core check",
    "typecheck": "bun --bun next typegen && bun --bun tsc --noEmit && bun --bun tsc --project scripts/tsconfig.json",
    "architecture:check": "biome lint --only=style/noRestrictedImports ."
  },
  "dependencies": {
    "@ast-grep/napi": "0.45.3",
    "@corespeed/lore-core": "workspace:*",
    "@corespeed/lore-sdk": "workspace:*",
    "@google/genai": "^2.23.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@vercel/otel": "^2.1.3",
    "cohere-ai": "^8.1.0",
    "d3": "^7.9.0",
    "hono": "^4.13.8",
    "jose": "^6.2.12",
    "next": "^16.3.5",
    "ollama": "^0.6.3",
    "openai": "^7.17.0",
    "pg": "^8.23.0",
    "pg-cloudflare": "^1.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "voyageai": "0.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@modelcontextprotocol/client": "^2.0.0",
    "@opennextjs/cloudflare": "^1.20.6",
    "@types/bun": "1.4.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dbmate": "2.35.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.10",
    "sharp": "^0.35.4",
    "undici": "^7.29.0"
  }
}
