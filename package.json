{
  "name": "lore",
  "version": "0.1.0",
  "description": "Open-source memory infrastructure for users and their agents.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": "24.x"
  },
  "homepage": "https://github.com/corespeed-io/lore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corespeed-io/lore.git"
  },
  "bugs": {
    "url": "https://github.com/corespeed-io/lore/issues"
  },
  "keywords": [
    "memory",
    "agents",
    "multi-tenant",
    "postgres",
    "rls"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build && bun run build:maintenance",
    "build:maintenance": "bun build src/worker/node-maintenance.ts --target=node --outfile=.worker/maintenance-worker.js --external pg",
    "db:migrate": "node scripts/migrate.mjs",
    "db:bootstrap": "node scripts/migrate.mjs && node scripts/create-runtime-role.mjs",
    "benchmark:graph:seed": "node scripts/seed-graph-benchmark.mjs",
    "benchmark:retrieval": "bun scripts/benchmark-retrieval.ts",
    "prototype:graph-scale": "BENCHMARK_DATABASE_URL=postgres://localhost:5432/lore_graph_benchmark next dev",
    "start": "next start",
    "start:maintenance": "node .worker/maintenance-worker.js",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --env-file .dev.vars.example --strict-vars false cloudflare-env.d.ts",
    "design:check": "node scripts/check-design-system.mjs . && node --test scripts/check-design-system.test.mjs",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "jose": "^6.2.8",
    "next": "^16.3.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "swr": "^2.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-pgvector": "^0.0.5",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.119.0"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "undici": "^7.29.0"
  }
}
