{
  "name": "lore",
  "version": "0.1.0",
  "description": "A knowledge-graph console and brain: force-directed graph, hybrid search, and durable agent memory over Postgres.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/corespeed-io/lore#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corespeed-io/lore.git"
  },
  "bugs": {
    "url": "https://github.com/corespeed-io/lore/issues"
  },
  "keywords": ["knowledge-graph", "memory", "mcp", "nextjs", "pgvector", "d3"],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "jose": "^6.2.3",
    "next": "^15.1.0",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electric-sql/pglite": "^0.4.3",
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/d3": "^7.4.3",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "postcss": "^8.5.10"
  },
  "bin": {
    "lore": "bin/lore.mjs"
  }
}
