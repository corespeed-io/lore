{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/.open-next",
      "!**/.wrangler",
      "!**/.worktrees",
      "!**/.claude",
      "!**/.gstack",
      "!**/.superpowers",
      "!**/node_modules",
      "!**/tmp",
      "!**/conductor.json",
      "!**/lore-*.json"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } }
}
