{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/.open-next",
      "!**/.worker",
      "!**/.wrangler",
      "!**/.worktrees",
      "!**/.claude",
      "!**/.gstack",
      "!**/.superpowers",
      "!**/evaluation/datasets",
      "!**/evaluation/results",
      "!**/packages/*/dist",
      "!**/node_modules",
      "!**/.venv",
      "!**/tmp",
      "!**/conductor.json",
      "!**/cloudflare-env.d.ts",
      "!**/lore-*.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/src/generated/**"],
      "formatter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      },
      "linter": {
        "rules": {
          "preset": "none"
        }
      }
    },
    {
      "includes": [
        "src/shell/**",
        "src/shared/browser/**",
        "src/shared/ui/**",
        "src/modules/*/browser/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@corespeed/lore-core",
                      "@corespeed/lore-core/**",
                      "@corespeed/lore-cli",
                      "@corespeed/lore-cli/**",
                      "@corespeed/lore-mcp",
                      "@corespeed/lore-mcp/**",
                      "**/packages/lore-core/**",
                      "**/packages/cli/**",
                      "**/packages/mcp/**",
                      "@/server/**",
                      "**/server/**",
                      "@/app/**",
                      "**/app/**",
                      "**/service",
                      "**/service.*",
                      "**/routes",
                      "**/routes.*",
                      "**/schemas",
                      "**/schemas.*",
                      "**/openapi",
                      "**/openapi.*",
                      "**/input",
                      "**/input.*",
                      "**/maintenance",
                      "**/maintenance.*",
                      "**/evidence",
                      "**/evidence.*",
                      "**/retrieval",
                      "**/retrieval.*",
                      "**/indexing/**",
                      "**/code/graph",
                      "**/code/graph.*",
                      "**/context/policy",
                      "**/context/policy.*"
                    ],
                    "message": "Browser modules use the Lore SDK and browser contracts; do not import Core, server implementations, CLI, or MCP, including types."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/typescript-sdk/src/**", "packages/cli/src/**", "packages/mcp/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/**",
                      "@corespeed/lore-core",
                      "@corespeed/lore-core/**",
                      "@corespeed/lore-cli",
                      "@corespeed/lore-cli/**",
                      "@corespeed/lore-mcp",
                      "@corespeed/lore-mcp/**",
                      "**/src/**",
                      "**/packages/**",
                      "**/lore-core/**",
                      "**/typescript-sdk/**",
                      "**/cli/**",
                      "**/mcp/**"
                    ],
                    "message": "Client packages must stay independent of OSS/Core and each other; CLI and MCP access Lore only through @corespeed/lore-sdk, including types."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
