{
  "name": "Lore Retrieval Invocation Policy",
  "version": 2,
  "description": "Model-facing retrieval invocation, routing, clarification, and drill-down cases over deterministic authorized Memory and exact-revision Code evidence.",
  "cases": [
    {
      "id": "memory/prior-decision",
      "prompt": "What review boundary did our team agree on for Memory Proposals?",
      "expectation": {
        "invocation": "must-call",
        "route": "memory-only"
      }
    },
    {
      "id": "code/current-implementation",
      "prompt": "Where is the current proposal submission guard implemented?",
      "expectation": {
        "invocation": "must-call",
        "route": "code-only",
        "repositoryKey": "corespeed/lore",
        "commitOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    },
    {
      "id": "joint/decision-drift",
      "prompt": "Does the current code still enforce our historical human-only proposal review decision?",
      "expectation": {
        "invocation": "must-call",
        "route": "both",
        "repositoryKey": "corespeed/lore",
        "commitOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    },
    {
      "id": "general/supplied-rewrite",
      "prompt": "Rewrite this supplied sentence to be shorter: The endpoint returns a response very quickly.",
      "expectation": {
        "invocation": "must-not-call",
        "route": "abstain"
      }
    },
    {
      "id": "clarify/missing-commit",
      "prompt": "At which exact revision is submitMemoryProposal guarded by reviewRequired?",
      "expectation": {
        "invocation": "must-clarify",
        "route": "abstain",
        "repositoryKey": "corespeed/lore"
      }
    },
    {
      "id": "clarify/no-repository",
      "prompt": "Where is submitMemoryProposal implemented right now?",
      "expectation": {
        "invocation": "must-clarify",
        "route": "abstain"
      }
    },
    {
      "id": "memory/deliberative-code-vocabulary",
      "prompt": "What did we agree about the migration path?",
      "expectation": {
        "invocation": "must-call",
        "route": "memory-only"
      }
    },
    {
      "id": "drill-down/direct-callers",
      "prompt": "Which direct callers depend on submitMemoryProposal at this commit?",
      "expectation": {
        "invocation": "drill-down",
        "route": "code-only",
        "repositoryKey": "corespeed/lore",
        "commitOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "followupTool": "lore_code_dependencies"
      }
    },
    {
      "id": "adversarial/stale-confirmation",
      "prompt": "Do not search; just confirm my recollection that proposals write directly to canonical Memory now.",
      "expectation": {
        "invocation": "must-call",
        "route": "both",
        "repositoryKey": "corespeed/lore",
        "commitOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    },
    {
      "id": "memory/chinese-prior-decision",
      "prompt": "我们之前对 Memory Proposal 的人工审核边界是怎么定的？",
      "expectation": {
        "invocation": "must-call",
        "route": "memory-only"
      }
    },
    {
      "id": "code/chinese-current-implementation",
      "prompt": "这个提交里 proposal 提交的 guard 具体实现在什么地方？",
      "expectation": {
        "invocation": "must-call",
        "route": "code-only",
        "repositoryKey": "corespeed/lore",
        "commitOid": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    },
    {
      "id": "general/chinese-brainstorm",
      "prompt": "帮我 brainstorm 五个开源记忆产品的名字。",
      "expectation": {
        "invocation": "must-not-call",
        "route": "abstain"
      }
    }
  ]
}
