# --- The brain ---
# Postgres 12+ with the vector (pgvector 0.5+) and pg_trgm extensions.
DATABASE_URL=postgres://user:pass@localhost:5432/lore

# Embeddings: any OpenAI-compatible /embeddings endpoint, including a local one.
# The example below is ollama, which needs no key of its own.
EMBEDDINGS_URL=http://localhost:11434/v1/embeddings
EMBEDDINGS_API_KEY=ollama
EMBEDDINGS_MODEL=qwen3-embedding:0.6b
EMBEDDINGS_DIM=1024
#     Changing the model or the dimension later = re-embed (it fails loud).
#     pgvector indexes an HNSW at most 2000 dims — above that the index is
#     silently skipped and every search falls back to a sequential scan.
# EMBEDDINGS_QUERY_PREFIX=         # prepended to QUERY text only, never documents.
#     The strong 2026 models are trained asymmetrically and want a one-line task
#     instruction on the query (Qwen3, Harrier: "Instruct: <task>\nQuery: ").
#     Symmetric models (bge-m3) want none — leave it empty. Changing it needs no
#     re-embed: it changes how a query is encoded, not what is stored.

# --- Agent access to the brain (POST /api/mcp, /import, /export, /maintenance) ---
# Both are >=16 chars or they are refused outright. The write token also gates
# /import, /api/maintenance AND /api/export — a full dump bypasses the read
# surface's filter, so the read token is deliberately not enough for it.
BRAIN_WRITE_TOKEN=               # agents' bearer for read+write tools
BRAIN_READ_TOKEN=                # optional read-only bearer

APP_TITLE=Lore
# APP_SUBTITLE=A searchable knowledge graph of your memory.
# SEED_QUERIES=overview getting started || architecture design decisions || people team roles

# --- Who may open the console ---
# Defaults to LOCAL DEV with auth OFF so `npm run dev` works out of the box.
# NEVER deploy with ALLOW_INSECURE=1 — it serves your private brain to anyone.
AUTH_MODE=none
ALLOW_INSECURE=1

# For a deployment, remove the two lines above and pick ONE:
#
#   password: HTTP Basic. Any username, this password.
# AUTH_MODE=password
# UI_PASSWORD=changeme
#
#   gateway: an upstream proxy (Cloudflare Access, oauth2-proxy, Authelia, an
#   ingress controller) authenticates the user and forwards who they are.
#
#   The identity header is read ONLY after the gateway proves it IS the gateway.
#   A header is typed by whoever is talking to us, so trusting X-Forwarded-User
#   on its own is a login form with no password. Pick a proof:
# AUTH_MODE=gateway
#
#   (a) verify a JWT the gateway signed — strongest, and what Cloudflare Access
#       already sends. For Cloudflare, ISSUER is your team domain and AUDIENCE
#       is the Access application's AUD tag.
# AUTH_GATEWAY_JWKS_URL=https://yourteam.cloudflareaccess.com/cdn-cgi/access/certs
# AUTH_GATEWAY_ISSUER=https://yourteam.cloudflareaccess.com
# AUTH_GATEWAY_AUDIENCE=...
# AUTH_GATEWAY_JWT_HEADER=Cf-Access-Jwt-Assertion     # default
#
#   (b) or a shared secret the gateway adds and no client can guess. Works with
#       any proxy that can set a header; compared in constant time.
# AUTH_GATEWAY_SHARED_SECRET=...
# AUTH_GATEWAY_SECRET_HEADER=X-Auth-Gateway-Secret    # default
#
#   Identity, read only after one of the above holds. A verified JWT's own
#   subject wins over this header.
# AUTH_GATEWAY_USER_HEADER=X-Forwarded-User           # default
#
#   Neither proof configured ⇒ gateway mode refuses every request. There is no
#   "just trust the header" setting on purpose.
