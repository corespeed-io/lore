{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "abstain", "claims"],
  "properties": {
    "answer": { "type": "string" },
    "abstain": { "type": "boolean" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "citations"],
        "properties": {
          "text": { "type": "string" },
          "citations": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
