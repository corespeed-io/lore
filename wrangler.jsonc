{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lore",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace this with a Hyperdrive configuration created with
      // `--caching-disabled`. RLS/auth reads must never use query caching.
      "id": "00000000000000000000000000000000"
    }
  ],
  "vars": {
    "AUTH_MODE": "proxy",
    "ACCESS_TEAM_DOMAIN": "replace-me.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-access-audience"
  }
}
