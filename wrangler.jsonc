{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lore",
  "main": "worker.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "queues": {
    "producers": [
      {
        "binding": "MEMORY_MAINTENANCE_QUEUE",
        "queue": "lore-memory-maintenance"
      }
    ],
    "consumers": [
      {
        "queue": "lore-memory-maintenance",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 8,
        "dead_letter_queue": "lore-memory-maintenance-dead-letter",
        "max_concurrency": 4
      }
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace this with a Hyperdrive configuration created with
      // `--caching-disabled`. RLS/auth reads must never use query caching.
      "id": "00000000000000000000000000000000"
    },
    {
      "binding": "MAINTENANCE_HYPERDRIVE",
      // Create this second cache-disabled configuration with the separate
      // login that is a member of only the `lore_maintenance` role.
      "id": "11111111111111111111111111111111"
    }
  ],
  "vars": {
    "AUTH_MODE": "proxy",
    "ACCESS_TEAM_DOMAIN": "replace-me.cloudflareaccess.com",
    "ACCESS_AUD": "replace-with-access-audience",
    "LORE_EMBEDDING_PROVIDER": "google",
    "LORE_EMBEDDING_MODEL": "gemini-embedding-2",
    "LORE_EMBEDDING_BUILD_PROVIDER": "",
    "LORE_EMBEDDING_BUILD_MODEL": "",
    "LORE_EMBEDDING_ROLLBACK_SECONDS": "604800",
    "LORE_EMBEDDING_TIMEOUT_MS": "120000",
    "LORE_SEMANTIC_DISTANCE_THRESHOLD": "0.5",
    "LORE_ENTITY_ALIAS_RECALL": "0",
    "LORE_EVIDENCE_NEIGHBOR_CHUNKS": "0",
    "LORE_EVIDENCE_TOP_CHUNKS": "1",
    "LORE_RETRIEVAL_FEEDBACK_QUERIES": "0",
    "LORE_RETRIEVAL_RECENCY_WEIGHT": "0",
    "LORE_RERANK_PROVIDER": "",
    "LORE_RERANK_MODEL": "",
    "LORE_RERANK_BASE_URL": "",
    "LORE_RERANK_TIMEOUT_MS": "30000",
    "LORE_RERANK_CANDIDATE_LIMIT": "50",
    "LORE_RERANK_MIN_SCORE": "",
    "LORE_RERANK_DIVERSITY_LAMBDA": "",
    "LORE_RERANK_WEIGHT": "",
    "LORE_RERANK_INSTRUCTION": "",
    "LORE_RERANK_NUM_CTX": "8192",
    "LORE_RERANK_MAX_OUTPUT_TOKENS": "2048",
    "LORE_RERANK_MAX_DOCUMENT_CHARS": "600",
    "LORE_RERANK_KEEP_ALIVE": "0",
    "LORE_QUERY_PLANNER_PROVIDER": "",
    "LORE_QUERY_PLANNER_MODEL": "",
    "LORE_QUERY_PLANNER_BASE_URL": "",
    "LORE_QUERY_PLANNER_TIMEOUT_MS": "30000",
    "LORE_QUERY_PLANNER_MAX_QUERIES": "3",
    "LORE_QUERY_PLANNER_INSTRUCTION": "",
    "LORE_QUERY_PLANNER_KEEP_ALIVE": "0",
    "LORE_QUERY_PLANNER_NUM_CTX": "4096"
  }
}
